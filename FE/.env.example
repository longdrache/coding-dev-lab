NEXT_PUBLIC_API_URL=http://localhost:4000

# Host cổng thanh toán được tin cậy, phân tách bằng dấu phẩy. Mặc định chỉ có
# `checkout.stripe.com` (xem FE/lib/checkout-url.ts) — thêm host ở đây khi đổi
# cổng thanh toán, để FE không đưa người dùng đi tới một URL lạ.
# Lưu ý: biến NEXT_PUBLIC_* được nội tuyến lúc BUILD, nên đổi ở đây phải build
# lại mới có tác dụng.
# NEXT_PUBLIC_CHECKOUT_HOSTS=pay.momo.vn,pay.vnpay.vn
