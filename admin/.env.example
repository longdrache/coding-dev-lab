# Admin frontend env
# BE thật mà BFF proxy forward tới (server-side, không lộ ra browser)
BE_API_URL=http://localhost:4000
# Dự phòng khi thiếu BE_API_URL (dev local)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Must match BE JWT_SECRET — used by proxy.ts (jose) to verify admin_token
JWT_SECRET=dev-jwt-secret-32-chars-min-please-change
