# Backend port
PORT=4000

# Clerk backend secret key from Clerk Dashboard (never expose in frontend)
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
FRONTEND_URL=http://localhost:3000
# Optional PEM public key from Clerk Dashboard for networkless JWT verification
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Clerk
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Judge0 URL inside Docker Compose
JUDGE0_URL=http://judge0-server:2358

# Mailer trả lời QNA — ưu tiên Mailtrap Sending API bằng token
MAIL_API_TOKEN=replace-me
MAIL_FROM_EMAIL=no-reply@gocode.lab
# Fallback SMTP khi không có MAIL_API_TOKEN (Mailtrap sandbox/Gmail)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=replace-me
EMAIL_PASSWORD=replace-me
EMAIL_FROM=GoCode <no-reply@gocode.lab>
MAIL_API_TOKEN=replace-me
# Admin dashboard (credential-only, no SignUp) — mặc định admin/admin
# JWT RS256: BE ký bằng PRIVATE key, FE verify bằng PUBLIC key (FE không giữ secret)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_PASSWORD_HASH=$2b$10$QVWcya537Cs.YBRK1YYJz.ec67Mo8qgrRpwtTfWjvSt9dJ8Go/m5i
ADMIN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ADMIN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Legacy fallback cho cookie HS256 cũ (có thể xóa sau khi tất cả đã login lại)
JWT_SECRET=dev-jwt-secret-32-chars-min-please-change

# Add private keys here when the application needs them.
# EXTERNAL_API_KEY=replace-me
