# Backend port
PORT=4000

# Stripe
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
FRONTEND_URL=http://localhost:3000

# Judge0 URL inside Docker Compose
JUDGE0_URL=http://judge0-server:2358
# Token cho nginx auth trước Judge0 (X-Auth-Token). Để trống = public
JUDGE0_API_TOKEN=replace-me

# Mail — gửi qua SMTP của **Brevo** (tên cũ Sendinblue). Dùng chung một bộ ba
# biến này cho cả mail đăng ký/xác minh/đặt lại mật khẩu lẫn mail trả lời QNA.
#
# Cả ba đều BẮT BUỘC. Thiếu bất kỳ biến nào thì lúc gửi mail sẽ log lỗi nêu
# đúng tên biến thiếu và **không** gửi. Không có giá trị dự phòng nào: một địa
# chỉ gửi mặc định bịa ra sẽ bị Brevo chặn, mà log vẫn sạch — đúng trạng thái
# khiến sự cố mail hỏng không ai nhìn thấy.
#
# BREVO_SMTP_LOGIN: tài khoản đăng nhập SMTP, thường là email của tài khoản Brevo.
#   Lấy ở Brevo → SMTP & API (tab "SMTP").
BREVO_SMTP_LOGIN=replace-me
# BREVO_SMTP_KEY: **SMTP key**, lấy ở đúng trang đó.
#   ⚠ PHẢI là khoá SMTP dạng `xsmtpsib-...`, KHÔNG phải API key dạng `xkeysib-...`.
#   Tài khoản Brevo có sẵn API key ở trang khác, nhưng hai loại khoá này không
#   dùng thay nhau được — dán API key vào đây thì SMTP fail bằng 401 khó hiểu.
#   BE có kiểm tra tiền tố `xkeysib-` và báo lỗi nói thẳng trước khi gửi.
BREVO_SMTP_KEY=xsmtpsib-replace-me
# MAIL_FROM: địa chỉ người gửi, **chỉ địa chỉ** (không kèm tên hiển thị — BE tự
#   thêm `GoCode <...>`), và PHẢI là sender đã xác minh trên Brevo.
#   Lấy/xác minh ở Brevo → Senders & Domains. Brevo từ chối gửi từ địa chỉ chưa
#   xác minh (xác minh bằng DNS hoặc bằng email), và nhiều hệ thống nhận thư cũng
#   chặn sender lạ.
MAIL_FROM=no-reply@gocode.lab
# Admin dashboard (credential-only, no SignUp) — mặc định admin/admin
# JWT RS256: BE ký bằng PRIVATE key, FE verify bằng PUBLIC key (FE không giữ secret)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_PASSWORD_HASH=$2b$10$QVWcya537Cs.YBRK1YYJz.ec67Mo8qgrRpwtTfWjvSt9dJ8Go/m5i
ADMIN_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ADMIN_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Legacy fallback cho cookie HS256 cũ (có thể xóa sau khi tất cả đã login lại)
JWT_SECRET=dev-jwt-secret-32-chars-min-please-change

# Đăng nhập bằng Google (OAuth 2.0 + PKCE S256).
# Thiếu BẤT KỲ biến nào trong ba biến này thì nút Google báo `?oauth=failed`
# ngay ở bước bấm, chứ không phải sau khi người dùng đã chọn tài khoản bên Google.
# Lấy ở Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (loại "Web application"). Ba giá trị dưới đây là chỗ dành cho người đọc, KHÔNG
# phải bí mật thật — không có secret nào được ghi vào file trong repo.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# Client secret, chỉ dùng ở bước đổi authorization code lấy access token
GOOGLE_CLIENT_SECRET=replace-me
# PHẢI khớp chính xác với "Authorized redirect URIs" khai trong Google Cloud,
# và phải là URL tuyệt đối của BE (không phải URL của FE) vì đây là nơi Google
# gửi code về. Sai một dấu `/` là hỏng, và Google không báo lý do.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/oauth/google/callback

# Add private keys here when the application needs them.
# EXTERNAL_API_KEY=replace-me
