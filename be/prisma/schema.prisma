// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  name                 String?
  passwordHash         String?
  role                 String    @default("user")
  vipExpiresAt         DateTime?
  emailVerifiedAt      DateTime?
  stripeSubscriptionId String?
  premiumPlan          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tokens        UserToken[]
  activityDays  ActivityDay[]
  solvedProblems SolvedProblem[]
  favorites     FavoriteProblem[]
  submissions   Submission[]
  badges        UserBadge[]
  pageViews     PageView[]
  loginEvents   LoginEvent[]
}

model UserToken {
  id             String    @id @default(cuid())
  userId         Int
  type           String
  tokenHash      String
  prevTokenHash  String?
  prevValidUntil DateTime?
  userAgent      String?
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

model Test {
  id String @id @default(uuid())
}

model ActivityDay {
  id        String   @id @default(cuid())
  userId    Int
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SolvedProblem {
  id         String   @id @default(cuid())
  userId     Int
  slug       String
  difficulty String?
  solvedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model FavoriteProblem {
  id        String   @id @default(cuid())
  userId    Int
  slug      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     Int
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Problem {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  difficulty   String
  topic        String
  status       String   @default("draft")
  description  String   @db.Text
  inputFormat  String   @db.Text @default("")
  outputFormat String   @db.Text @default("")
  constraints  Json     @default("[]")
  examples     Json     @default("[]")
  tests        Json
  hiddenTests  Json     @default("[]")
  starterCodes Json?    @default("{}")
  timeLimit    Int?     @default(1000)
  memoryLimit  Int?     @default(256000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  userId       Int
  problemSlug  String
  languageId   Int
  sourceCode   String   @db.Text
  status       String?
  statusId     Int?
  passed       Boolean?
  passedCount  Int?
  totalCount   Int?
  time         String?
  memory       Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemSlug])
  @@index([userId, problemSlug])
}

model QnaQuestion {
  id        String   @id @default(cuid())
  clerkId   String?
  name      String
  email     String
  question  String   @db.Text
  createdAt DateTime @default(now())

  @@index([email])
  @@index([clerkId])
}

// Log event Stripe đã xử lý — chống retry gia hạn VIP vô hạn
model StripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Lượt xem trang: định danh user đăng nhập (userId), khách vãng lai
// thì dùng hash IP (không lưu IP thô) — cho analytics admin
model PageView {
  id        String   @id @default(cuid())
  userId    Int?
  visitorId String?
  ipHash    String
  country   String   @default("")
  path      String   @default("/")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
}

// Lần đăng nhập: ai, từ quốc gia nào (Vercel header), IP hash — cho admin
model LoginEvent {
  id        String   @id @default(cuid())
  userId    Int?
  ipHash    String
  country   String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([country, createdAt])
}
