// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  name                 String?
  // Ảnh đại diện lấy từ `picture` của Google userinfo. `String?` chứ không phải
  // `String` vì tài khoản đăng ký bằng mật khẩu không có ảnh nào, và tài khoản
  // đã tồn tại từ trước cũng để null — cột nullable mới thêm được mà không phải
  // ghi đè dữ liệu.
  avatarUrl            String?
  passwordHash         String?
  role                 String    @default("user")
  vipExpiresAt         DateTime?
  emailVerifiedAt      DateTime?
  stripeSubscriptionId String?
  premiumPlan          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tokens        UserToken[]
  accounts      UserAccount[]
  activityDays  ActivityDay[]
  solvedProblems SolvedProblem[]
  favorites     FavoriteProblem[]
  submissions   Submission[]
  badges        UserBadge[]
  pageViews     PageView[]
  loginEvents   LoginEvent[]
  qnaQuestions  QnaQuestion[]
}

model UserToken {
  id             String    @id @default(cuid())
  userId         Int
  type           String
  tokenHash      String
  prevTokenHash  String?
  prevValidUntil DateTime?
  userAgent      String?
  lastUsedAt     DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

// Liên kết user nội bộ với tài khoản ở nhà cung cấp danh tính bên ngoài.
// Unique (provider, providerUserId) là chốt chặn đăng nhập trùng: cùng một
// tài khoản Google chỉ được gắn vào đúng một user.
model UserAccount {
  id             Int      @id @default(autoincrement())
  userId         Int
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

// State tạm của một lần chạy luồng OAuth, khoá theo hash để DB không chứa
// `state`/`codeVerifier` dạng rõ. Không có quan hệ với User: state sinh ra
// trước lúc biết user nào sẽ đăng nhập.
//
// `usedAt` giữ lại dù dòng đã dùng thì bị **xoá hẳn** (`consumeState`): nó là
// bất biến `usedAt IS NULL` mà câu `DELETE` của `consumeState` lọc, nên dữ liệu
// cũ đã đánh dấu đã dùng vẫn bị từ chối đúng, và lịch dọn bên dưới xoá được cả
// dòng cũ lẫn dòng mới theo cùng một điều kiện.
model UserOAuthState {
  stateHash    String    @id
  codeVerifier String
  redirectTo   String
  expiresAt    DateTime
  usedAt       DateTime?

  // Lịch dọn xoá theo hạn: không có index này thì mỗi lần quét phải quét cả
  // bảng, và bảng này phình theo **số lần bấm nút** chứ không theo số người.
  @@index([expiresAt])
}

model ActivityDay {
  id        String   @id @default(cuid())
  userId    Int
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SolvedProblem {
  id         String   @id @default(cuid())
  userId     Int
  slug       String
  difficulty String?
  solvedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model FavoriteProblem {
  id        String   @id @default(cuid())
  userId    Int
  slug      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     Int
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Problem {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  difficulty   String
  topic        String
  status       String   @default("draft")
  // Bài chỉ mở cho tài khoản VIP. Quyết định quyền KHÔNG đọc cột này trực tiếp:
  // nó chỉ là nhãn trên dữ liệu, còn quyền do `role` đã ký trong access token
  // quyết định (xem `src/problems/vip-problem.policy.ts`).
  isVip        Boolean  @default(false)
  description  String   @db.Text
  inputFormat  String   @db.Text @default("")
  outputFormat String   @db.Text @default("")
  constraints  Json     @default("[]")
  examples     Json     @default("[]")
  tests        Json
  hiddenTests  Json     @default("[]")
  starterCodes Json?    @default("{}")
  timeLimit    Int?     @default(1000)
  memoryLimit  Int?     @default(256000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id           String   @id @default(cuid())
  userId       Int
  problemSlug  String
  languageId   Int
  sourceCode   String   @db.Text
  status       String?
  statusId     Int?
  passed       Boolean?
  passedCount  Int?
  totalCount   Int?
  time         String?
  memory       Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemSlug])
  @@index([userId, problemSlug])
}

// Câu hỏi hỗ trợ từ user. Khách không đăng nhập cũng gửi được nên `userId`
// nullable — cố ý KHÔNG `onDelete: Cascade` như 6 bảng dữ liệu chính, để
// câu hỏi của khách không bị mất khi tài khoản bị xoá.
model QnaQuestion {
  id        String   @id @default(cuid())
  userId    Int?
  name      String
  email     String
  question  String   @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
}

// Log event Stripe đã xử lý — chống retry gia hạn VIP vô hạn
model StripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Lượt xem trang: định danh user đăng nhập (userId), khách vãng lai
// thì dùng hash IP (không lưu IP thô) — cho analytics admin
model PageView {
  id        String   @id @default(cuid())
  userId    Int?
  visitorId String?
  ipHash    String
  country   String   @default("")
  path      String   @default("/")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
}

// Lần đăng nhập: ai, từ quốc gia nào (Vercel header), IP hash — cho admin
model LoginEvent {
  id        String   @id @default(cuid())
  userId    Int?
  ipHash    String
  country   String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([country, createdAt])
}
