// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  nothing   String?
  clerkId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id String @id @default(uuid())
}

model ActivityDay {
  id        String   @id @default(cuid())
  clerkId   String
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clerkId, date])
  @@index([clerkId])
}

model SolvedProblem {
  id         String   @id @default(cuid())
  clerkId    String
  slug       String
  difficulty String?
  solvedAt   DateTime @default(now())

  @@unique([clerkId, slug])
  @@index([clerkId])
}

model FavoriteProblem {
  id        String   @id @default(cuid())
  clerkId   String
  slug      String
  createdAt DateTime @default(now())

  @@unique([clerkId, slug])
  @@index([clerkId])
}

model UserBadge {
  id         String   @id @default(cuid())
  clerkId    String
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([clerkId, badgeId])
  @@index([clerkId])
}

model Problem {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  difficulty   String
  topic        String
  status       String   @default("draft")
  description  String   @db.Text
  inputFormat  String   @db.Text @default("")
  outputFormat String   @db.Text @default("")
  constraints  Json     @default("[]")
  examples     Json     @default("[]")
  tests        Json
  hiddenTests  Json     @default("[]")
  starterCodes Json?    @default("{}")
  timeLimit    Int?     @default(1000)
  memoryLimit  Int?     @default(256000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  clerkId     String
  problemSlug String
  languageId  Int
  sourceCode  String   @db.Text
  status      String?
  statusId    Int?
  passed      Boolean?
  passedCount Int?
  totalCount  Int?
  time        String?
  memory      Int?
  createdAt   DateTime @default(now())

  @@index([clerkId])
  @@index([problemSlug])
  @@index([clerkId, problemSlug])
}

model QnaQuestion {
  id        String   @id @default(cuid())
  clerkId   String?
  name      String
  email     String
  question  String   @db.Text
  createdAt DateTime @default(now())

  @@index([email])
  @@index([clerkId])
}

// Log event Stripe đã xử lý — chống retry gia hạn VIP vô hạn
model StripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Lượt xem trang: định danh user đăng nhập (clerkId), khách vãng lai
// thì dùng hash IP (không lưu IP thô) — cho analytics admin
model PageView {
  id        String   @id @default(cuid())
  clerkId   String?
  ipHash    String
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([clerkId, createdAt])
}
